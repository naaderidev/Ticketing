{
  "name": "ticketing-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo node_modules/next/dist/bin/next dev -H 0.0.0.0 -p 3009",
    "build": "next build",
    "start": "next start",
    "start:demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3009",
    "scheduler:maintenance": "node --env-file=.env --env-file-if-exists=.env.development.local scripts/maintenance-scheduler.mjs",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage:jest": "jest --coverage --runInBand",
    "test:coverage": "npm run test:coverage:jest && node scripts/check-critical-coverage.mjs",
    "test:release-contract": "node --test --test-isolation=none scripts/release-readiness.test.mjs",
    "test:demo-deployment": "node --test --test-isolation=none scripts/demo-reset-safety.node.mjs",
    "test:staging-rehearsal": "node --test --test-isolation=none scripts/staging-rehearsal.test.mjs",
    "test:go-live-evidence": "node --test --test-isolation=none scripts/go-live-evidence.test.mjs",
    "test:production-verification": "node --test --test-isolation=none scripts/production-verification.test.mjs",
    "test:release-closure": "node --test --test-isolation=none scripts/release-closure-evidence.test.mjs",
    "test:legacy-retirement": "node --test --test-isolation=none scripts/legacy-retirement-evidence.test.mjs",
    "verify:r4-data": "node --env-file=.env scripts/r4-data-reconciliation.mjs",
    "verify:r5-data": "node --env-file=.env scripts/r5-data-reconciliation.mjs",
    "verify:r6-data": "node --env-file=.env scripts/r6-data-reconciliation.mjs",
    "verify:sla-calendar": "node --env-file=.env scripts/verify-sla-calendar.mjs",
    "db:reseed-product": "npm run db:bootstrap-demo",
    "db:seed-demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo scripts/reset-and-seed-product-data.mjs --confirm=RESET_DEMO_DATABASE",
    "db:bootstrap-demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo scripts/bootstrap-demo-database.mjs --confirm=RESET_DEMO_DATABASE",
    "db:normalize-jalali-dates": "node --env-file=.env scripts/normalize-jalali-date-data.mjs",
    "verify:reporting-demo-data": "node --env-file=.env scripts/reporting-demo-data-smoke.mjs",
    "verify:demo-accounts": "node --env-file=.env scripts/demo-accounts-smoke.mjs",
    "test:reporting-demo-dashboard": "node --env-file=.env scripts/run-reporting-demo-dashboard-test.mjs",
    "test:r4-runtime": "node --env-file=.env scripts/r4-runtime-smoke.mjs",
    "test:r5-runtime": "node --env-file=.env scripts/r5-runtime-smoke.mjs",
    "test:r6-runtime": "node --env-file=.env scripts/r6-runtime-smoke.mjs",
    "test:r7-runtime": "node --env-file=.env scripts/r7-runtime-smoke.mjs",
    "test:r8-runtime": "node --env-file=.env scripts/r8-runtime-smoke.mjs",
    "test:r9-runtime": "node --env-file=.env scripts/r9-runtime-smoke.mjs",
    "test:kpi-r1-data-model": "node --env-file=.env scripts/kpi-r1-data-model-smoke.mjs",
    "test:kpi-r2-domain-events": "node --env-file=.env scripts/kpi-r2-domain-events-smoke.mjs",
    "test:kpi-r3-projection": "node --env-file=.env scripts/kpi-r3-reporting-projection-smoke.mjs",
    "test:kpi-r4-time-sla": "node --env-file=.env scripts/kpi-r4-time-sla-smoke.mjs",
    "test:kpi-r5-quality": "node --env-file=.env scripts/kpi-r5-quality-smoke.mjs",
    "test:kpi-r6-automated-resolution": "node --env-file=.env scripts/kpi-r6-automated-resolution-smoke.mjs",
    "test:kpi-r7-ticket-per-transaction": "node --env-file=.env scripts/kpi-r7-ticket-per-transaction-smoke.mjs",
    "test:kpi-r8-recurring-problems": "node --env-file=.env scripts/kpi-r8-recurring-problems-smoke.mjs",
    "test:kpi-r9-reporting-api-access": "node --env-file=.env scripts/kpi-r9-reporting-api-access-smoke.mjs",
    "test:kpi-r10-management-dashboard": "jest --runInBand src/__tests__/modules/reporting/reporting-dashboard-range.test.ts src/__tests__/components/reporting-dashboard.test.tsx src/__tests__/components/reporting-navigation.test.tsx src/__tests__/components/admin-reporting-page.test.tsx",
    "test:kpi-r11-reporting-release": "node --env-file-if-exists=.env scripts/kpi-r11-reporting-backfill-release-smoke.mjs",
    "test:kpi-r12-controlled-rollout": "node --test --test-isolation=none scripts/reporting-controlled-rollout.test.mjs && jest --runInBand src/__tests__/lib/reporting-rollout-config.test.ts src/__tests__/lib/runtime-metrics.test.ts src/__tests__/api/reporting-release-readiness.test.ts src/__tests__/modules/shared/reporting-rollout-authorization.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:release-contract": "node scripts/check-release-readiness.mjs",
    "verify:release-candidate": "node scripts/check-release-readiness.mjs --require-release-id --output release-contract.json",
    "verify:demo": "npm run test:demo-deployment && npm run lint && npm run typecheck && npm run test:ci && npx prisma validate && npm run build",
    "verify:release": "npm run verify:demo",
    "verify:staging": "node scripts/check-staging-readiness.mjs",
    "verify:go-live-evidence": "node scripts/check-go-live-readiness.mjs",
    "verify:production": "node scripts/check-production-verification.mjs",
    "verify:release-closure": "node scripts/check-release-closure.mjs",
    "verify:legacy-retirement": "node scripts/check-legacy-retirement.mjs",
    "verify:reporting-rollout": "node scripts/check-reporting-controlled-rollout.mjs",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.39.0",
    "mysql2": "^3.24.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-date-object": "2.1.9",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-multi-date-picker": "4.5.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
}
