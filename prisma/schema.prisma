  ticketId                  Int                @unique
  policyId                  Int
  calendarId                Int?
  policyCode                String             @db.VarChar(64)
  policyVersion             Int
  calendarCode              String?            @db.VarChar(64)
  calendarVersion           Int?
  clockType                 SlaClockType
  firstResponseMinutes      Int
  resolutionMinutes         Int
  enforcementMode           SlaEnforcementMode @default(OBSERVE_ONLY)
  firstResponseState        SlaTargetState     @default(PENDING)
  resolutionState           SlaTargetState     @default(PENDING)
  firstResponseWarningLevel SlaWarningLevel    @default(NONE)
  resolutionWarningLevel    SlaWarningLevel    @default(NONE)
  resolutionEscalationLevel SlaEscalationLevel @default(NONE)
  startedAt                 DateTime
  resolutionCycleNumber     Int                @default(1)
  resolutionCycleStartedAt  DateTime
  firstResponseWarning70At  DateTime
  firstResponseWarning90At  DateTime
  firstResponseDueAt        DateTime
  resolutionWarning70At     DateTime
  resolutionWarning90At     DateTime
  resolutionDueAt           DateTime
  resolutionManagerAt       DateTime
  firstRespondedAt          DateTime?
  resolvedAt                DateTime?
  pausedAt                  DateTime?
  totalPausedMilliseconds   BigInt             @default(0)
  legacyImported            Boolean            @default(false)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  ticket                    Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  policy                    SlaPolicy          @relation(fields: [policyId], references: [id], onDelete: Restrict)
  calendar                  SlaCalendar?       @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  pauses                    TicketSlaPause[]

  @@index([firstResponseState, firstResponseDueAt])
  @@index([resolutionState, resolutionDueAt])
  @@index([resolutionEscalationLevel, resolutionManagerAt], map: "TicketSla_resolutionEscalation_manager_idx")
  @@index([enforcementMode, legacyImported])
}

model TicketSlaPause {
  id                   BigInt         @id @default(autoincrement())
  ticketSlaId          BigInt
  reason               SlaPauseReason
  startedAt            DateTime
  endedAt              DateTime?
  durationMilliseconds BigInt?
  activeKey            String?        @unique @db.VarChar(64)
  createdAt            DateTime       @default(now())
  ticketSla            TicketSla      @relation(fields: [ticketSlaId], references: [id], onDelete: Cascade)

  @@index([ticketSlaId, startedAt])
}

model RoutingDecision {
  id            BigInt                @id @default(autoincrement())
  ticketId      Int
  routeId       Int?
  requestTypeId Int
  supportTeamId Int
  queueId       Int
  slaPolicyId   Int?
  actorUserId   Int?
  source        RoutingDecisionSource
  ruleCode      String                @db.VarChar(100)
  ruleVersion   Int
  routeVersion  Int
  priority      SupportPriority
  reason        String?               @db.VarChar(500)
  inputSnapshot Json?
  createdAt     DateTime              @default(now())
  ticket        Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  route         SupportCatalogRoute?  @relation(fields: [routeId], references: [id], onDelete: Restrict)
  requestType   SupportRequestType    @relation(fields: [requestTypeId], references: [id], onDelete: Restrict)
  supportTeam   SupportTeam           @relation(fields: [supportTeamId], references: [id], onDelete: Restrict)
  queue         SupportQueue          @relation(fields: [queueId], references: [id], onDelete: Restrict)
  slaPolicy     SlaPolicy?            @relation(fields: [slaPolicyId], references: [id], onDelete: Restrict)
  actorUser     User?                 @relation("RoutingDecisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([supportTeamId, queueId, createdAt], map: "RoutingDecision_team_queue_createdAt_idx")
  @@index([slaPolicyId])
}

model LegacySupportCatalogMapping {
  id                   Int                        @id @default(autoincrement())
  sourceType           LegacyCatalogSourceType
  legacyId             Int
  departmentId         Int?
  subDepartmentId      Int?
  supportServiceId     Int?
  supportRequestTypeId Int?
  status               LegacyCatalogMappingStatus @default(PENDING)
  reviewedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  department           Department?                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subDepartment        SubDepartment?             @relation(fields: [subDepartmentId], references: [id], onDelete: Restrict)
  supportService       SupportService?            @relation(fields: [supportServiceId], references: [id], onDelete: Restrict)
  supportRequestType   SupportRequestType?        @relation(fields: [supportRequestTypeId], references: [id], onDelete: Restrict)

  @@unique([sourceType, legacyId])
  @@index([status, sourceType])
  @@index([supportServiceId])
  @@index([supportRequestTypeId])
}

model OrganizationAccessRequest {
  id             Int                              @id @default(autoincrement())
  organizationId Int
  requestedById  Int
  targetUserId   Int
  decidedById    Int?
  requestType    OrganizationAccessRequestType
  pendingKey     String?                          @unique @db.VarChar(191)
  requestedRole  OrganizationMembershipRole?
  status         AccessRequestStatus              @default(PENDING)
  reason         String                           @db.VarChar(500)
  decisionReason String?                          @db.VarChar(500)
  decidedAt      DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  organization   Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy    User                             @relation("AccessRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  targetUser     User                             @relation("AccessRequestTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  decidedBy      User?                            @relation("AccessRequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  scopes         OrganizationAccessRequestScope[]

  @@index([organizationId, status, createdAt])
  @@index([targetUserId, status])
  @@index([requestedById, createdAt])
}

model OrganizationAccessRequestScope {
  id        Int                       @id @default(autoincrement())
  requestId Int
  type      OrganizationScopeType
  scopeKey  String                    @db.VarChar(191)
  request   OrganizationAccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, type, scopeKey])
  @@index([type, scopeKey])
}

