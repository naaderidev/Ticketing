generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Department {
  id              Int                           @id @default(autoincrement())
  name            String                        @unique
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  internalOnly    Boolean                       @default(false)
  subDepartments  SubDepartment[]
  tickets         Ticket[]
  faqs            FAQ[]
  catalogMappings LegacySupportCatalogMapping[]
}

model SubDepartment {
  id                 Int                           @id @default(autoincrement())
  name               String
  departmentId       Int
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  internalOnly       Boolean                       @default(false)
  department         Department                    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tickets            Ticket[]
  faqs               FAQ[]
  predefinedMessages PredefinedMessage[]
  catalogMappings    LegacySupportCatalogMapping[]

  @@unique([name, departmentId])
}

model FAQ {
  id               Int               @id @default(autoincrement())
  question         String            @db.VarChar(500)
  answer           String            @db.Text
  priority         Int               @default(0)
  departmentId     Int
  subDepartmentId  Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subDepartment    SubDepartment?    @relation(fields: [subDepartmentId], references: [id], onDelete: SetNull)
  knowledgeArticle KnowledgeArticle?

  @@index([departmentId, subDepartmentId, priority])
}

model KnowledgeArticle {
  id                 Int                       @id @default(autoincrement())
  slug               String                    @unique @db.VarChar(191)
  audience           KnowledgeAudience         @default(AUTHENTICATED)
  status             KnowledgeArticleStatus    @default(DRAFT)
  serviceId          Int?
  requestTypeId      Int?
  searchKeywords     String?                   @db.Text
  sourceFaqId        Int?                      @unique
  createdById        Int?
  publishedVersionId BigInt?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  service            SupportService?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  requestType        SupportRequestType?       @relation(fields: [requestTypeId], references: [id], onDelete: SetNull)
  sourceFaq          FAQ?                      @relation(fields: [sourceFaqId], references: [id], onDelete: SetNull)
  createdBy          User?                     @relation("KnowledgeArticleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedVersion   KnowledgeArticleVersion?  @relation("PublishedKnowledgeVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  versions           KnowledgeArticleVersion[] @relation("KnowledgeArticleVersions")

  @@index([status, audience, updatedAt])
  @@index([serviceId, requestTypeId, status])
  @@index([createdById])
}

model KnowledgeArticleVersion {
  id                  BigInt                  @id @default(autoincrement())
  articleId           Int
  version             Int
  title               String                  @db.VarChar(500)
  body                String                  @db.Text
  approvalStatus      KnowledgeApprovalStatus @default(DRAFT)
  contentChecksum     String                  @db.Char(64)
  approvedById        Int?
  approvedAt          DateTime?
  publishedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  article             KnowledgeArticle        @relation("KnowledgeArticleVersions", fields: [articleId], references: [id], onDelete: Cascade)
  approvedBy          User?                   @relation("KnowledgeVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedForArticle KnowledgeArticle?       @relation("PublishedKnowledgeVersion")
  supportJourneys     SupportJourney[]

  @@unique([articleId, version])
  @@index([approvalStatus, publishedAt])
  @@index([approvedById])
}

model Ticket {
  id                    Int                          @id @default(autoincrement())
  ticketId              String                       @unique
  subject               String
  message               String                       @db.Text
  status                TicketStatus                 @default(OPEN)
  lifecycleStatus       TicketLifecycleStatus?
  priority              SupportPriority?
  version               Int                          @default(1)
  routeVersion          Int?
  userName              String
  departmentId          Int
  subDepartmentId       Int
  userId                Int?
  createdById           Int?
  partyId               Int?
  organizationId        Int?
  requestTypeId         Int?
  supportTeamId         Int?
  queueId               Int?
  ownerUserId           Int?
  servicePlanId         Int?
  legacyImported        Boolean                      @default(false)
  rating                Int?
  rootCause             String?                      @db.Text
  normalizedRootCauseId Int?
  resolutionSummary     String?                      @db.Text
  actionTaken           String?                      @db.Text
  finalResponse         String?                      @db.Text
  mergedIntoTicketId    Int?
  mergedById            Int?
  mergeReason           String?                      @db.VarChar(500)
  mergedAt              DateTime?
  closedBy              String?
  closedReason          String?
  closedAt              DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  department            Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subDepartment         SubDepartment                @relation(fields: [subDepartmentId], references: [id], onDelete: Restrict)
  user                  User?                        @relation("LegacyTicketUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy             User?                        @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  party                 Party?                       @relation(fields: [partyId], references: [id], onDelete: Restrict)
  organization          Organization?                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestType           SupportRequestType?          @relation(fields: [requestTypeId], references: [id], onDelete: Restrict)
  supportTeam           SupportTeam?                 @relation(fields: [supportTeamId], references: [id], onDelete: Restrict)
  queue                 SupportQueue?                @relation(fields: [queueId], references: [id], onDelete: Restrict)
  ownerUser             User?                        @relation("TicketOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  servicePlan           OrganizationServicePlan?     @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  accountReview         TicketAccountReview?
  replies               TicketReply[]
  attachments           TicketAttachment[]
  notifications         Notification[]
  messages              TicketMessage[]
  events                TicketEvent[]
  assignments           TicketAssignment[]
  businessReferences    TicketBusinessReference[]
  commandReceipts       TicketCommandReceipt[]
  sla                   TicketSla?
  routingDecisions      RoutingDecision[]
  workItems             TicketWorkItem[]
  resolutionCycles      TicketResolutionCycle[]
  normalizedRootCause   ReportingRootCauseDimension? @relation(fields: [normalizedRootCauseId], references: [id], onDelete: Restrict)
  mergedIntoTicket      Ticket?                      @relation("TicketMerge", fields: [mergedIntoTicketId], references: [id], onDelete: Restrict)
  mergedTickets         Ticket[]                     @relation("TicketMerge")
  mergedBy              User?                        @relation("TicketMergedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  reportingFact         TicketReportingFact?
  convertedJourneys     SupportJourney[]             @relation("SupportJourneyConvertedTicket")
  incidentLinks         SupportIncidentTicket[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([departmentId, subDepartmentId, createdAt])
  @@index([partyId, updatedAt, id])
  @@index([organizationId, updatedAt, id])
  @@index([queueId, lifecycleStatus, updatedAt, id])
  @@index([supportTeamId, lifecycleStatus, updatedAt, id])
  @@index([ownerUserId, lifecycleStatus, updatedAt, id])
  @@index([servicePlanId, createdAt])
  @@index([requestTypeId, lifecycleStatus, createdAt])
  @@index([normalizedRootCauseId])
  @@index([mergedIntoTicketId, mergedAt])
  @@index([mergedById, mergedAt])
}

model TicketMessage {
  id             BigInt                  @id @default(autoincrement())
  ticketId       Int
  visibility     TicketMessageVisibility @default(PUBLIC)
  authorType     TicketMessageAuthorType
  actorUserId    Int?
  authorPartyId  Int?
  authorSnapshot String?                 @db.VarChar(150)
  body           String                  @db.Text
  sourceType     TicketMessageSource     @default(NATIVE)
  legacySourceId Int?
  createdAt      DateTime                @default(now())
  ticket         Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUser      User?                   @relation("TicketMessageActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  authorParty    Party?                  @relation("TicketMessageParty", fields: [authorPartyId], references: [id], onDelete: SetNull)
  attachments    TicketAttachment[]

  @@unique([sourceType, legacySourceId])
  @@index([ticketId, createdAt, id])
}

model TicketEvent {
  id               BigInt                 @id @default(autoincrement())
  eventId          String                 @unique @db.Char(36)
  ticketId         Int
  type             String                 @db.VarChar(100)
  schemaVersion    Int                    @default(1)
  aggregateVersion Int?
  visibility       TicketEventVisibility  @default(INTERNAL)
  fromStatus       TicketLifecycleStatus?
  toStatus         TicketLifecycleStatus?
  actorType        TicketEventActorType
  sourceType       TicketEventSourceType
  actorUserId      Int?
  correlationId    String?                @db.Char(36)
  causationId      String?                @db.Char(36)
  reason           String?                @db.VarChar(500)
  metadata         Json?
  createdAt        DateTime               @default(now())
  ticket           Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUser        User?                  @relation("TicketEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  outboxEvent      OutboxEvent?

  @@index([ticketId, createdAt, id])
  @@index([ticketId, aggregateVersion, id])
  @@index([type, createdAt])
  @@index([actorType, sourceType, type, createdAt], map: "TicketEvent_actor_source_type_created_idx")
}

model OutboxEvent {
  id            BigInt           @id @default(autoincrement())
  eventId       String           @unique @db.Char(36)
  ticketEventId BigInt?          @unique
  aggregateType String           @db.VarChar(64)
  aggregateId   String           @db.VarChar(191)
  eventType     String           @db.VarChar(100)
  schemaVersion Int              @default(1)
  payload       Json
  occurredAt    DateTime         @default(now())
  availableAt   DateTime         @default(now())
  publishedAt   DateTime?
  attemptCount  Int              @default(0)
  lockedAt      DateTime?
  lastError     String?          @db.Text
  ticketEvent   TicketEvent?     @relation(fields: [ticketEventId], references: [id], onDelete: SetNull)
  deliveries    OutboxDelivery[]

  @@index([publishedAt, availableAt, id])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt])
}

model OutboxDelivery {
  id            BigInt               @id @default(autoincrement())
  outboxEventId BigInt
  consumer      String               @db.VarChar(100)
  status        OutboxDeliveryStatus @default(PENDING)
  attemptCount  Int                  @default(0)
  availableAt   DateTime             @default(now())
  lockedAt      DateTime?
  lockToken     String?              @unique @db.Char(36)
  processedAt   DateTime?
  lastError     String?              @db.VarChar(500)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  outboxEvent   OutboxEvent          @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@unique([outboxEventId, consumer])
  @@index([consumer, status, availableAt, id])
  @@index([lockedAt])
}

model TicketAssignment {
  id            BigInt       @id @default(autoincrement())
  ticketId      Int
  supportTeamId Int
  queueId       Int
  ownerUserId   Int?
  assignedById  Int?
  reason        String?      @db.VarChar(500)
  activeKey     String?      @unique @db.VarChar(64)
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  ticket        Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  supportTeam   SupportTeam  @relation(fields: [supportTeamId], references: [id], onDelete: Restrict)
  queue         SupportQueue @relation(fields: [queueId], references: [id], onDelete: Restrict)
  ownerUser     User?        @relation("TicketAssignmentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  assignedBy    User?        @relation("TicketAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([ticketId, startedAt])
  @@index([supportTeamId, queueId, endedAt])
  @@index([ownerUserId, endedAt])
}

model TicketWorkItem {
  id             BigInt               @id @default(autoincrement())
  ticketId       Int
  supportTeamId  Int
  queueId        Int
  assignedUserId Int?
  requestedById  Int
  request        String               @db.Text
  response       String?              @db.Text
  status         TicketWorkItemStatus @default(OPEN)
  createdAt      DateTime             @default(now())
  completedAt    DateTime?
  updatedAt      DateTime             @updatedAt
  ticket         Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  supportTeam    SupportTeam          @relation(fields: [supportTeamId], references: [id], onDelete: Restrict)
  queue          SupportQueue         @relation(fields: [queueId], references: [id], onDelete: Restrict)
  assignedUser   User?                @relation("TicketWorkItemAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  requestedBy    User                 @relation("TicketWorkItemRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([ticketId, status, createdAt])
  @@index([supportTeamId, queueId, status, createdAt])
  @@index([assignedUserId, status, createdAt])
}

model TicketResolutionCycle {
  id            BigInt                  @id @default(autoincrement())
  ticketId      Int
  sequence      Int
  proposedAt    DateTime
  reminderOneAt DateTime
  reminderTwoAt DateTime
  autoCloseAt   DateTime
  reminderCount Int                     @default(0)
  outcome       TicketResolutionOutcome @default(PENDING)
  activeKey     String?                 @unique @db.VarChar(64)
  closedAt      DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  ticket        Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, sequence])
  @@index([outcome, autoCloseAt, id])
  @@index([outcome, reminderCount, reminderOneAt, reminderTwoAt], map: "TicketResolutionCycle_reminders_idx")
}

model TicketBusinessReference {
  id                 BigInt                              @id @default(autoincrement())
  ticketId           Int
  organizationId     Int?
  referenceType      String                              @db.VarChar(64)
  referenceKey       String                              @db.VarChar(191)
  displayLabel       String?                             @db.VarChar(200)
  verificationStatus TicketBusinessReferenceVerification @default(UNVERIFIED)
  sourceSystem       String?                             @db.VarChar(64)
  entityType         String?                             @db.VarChar(64)
  externalId         String?                             @db.VarChar(191)
  snapshotFetchedAt  DateTime?
  snapshotExpiresAt  DateTime?
  sourceVersion      String?                             @db.VarChar(64)
  sourceEtag         String?                             @db.VarChar(191)
  createdAt          DateTime                            @default(now())
  ticket             Ticket                              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization       Organization?                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([ticketId, referenceType, referenceKey])
  @@index([referenceType, referenceKey])
  @@index([organizationId, ticketId])
  @@index([sourceSystem, entityType, externalId], map: "TicketBusinessReference_source_entity_external_idx")
  @@index([verificationStatus, referenceType, ticketId], map: "TicketBusinessReference_verified_type_ticket_idx")
}

model TicketCommandReceipt {
  id             BigInt                     @id @default(autoincrement())
  actorUserId    Int
  partyId        Int
  ticketId       Int?
  route          String                     @db.VarChar(100)
  keyHash        String                     @db.Char(64)
  payloadHash    String                     @db.Char(64)
  status         TicketCommandReceiptStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  actorUser      User                       @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  party          Party                      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  ticket         Ticket?                    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, partyId, route, keyHash])
  @@index([expiresAt])
  @@index([ticketId])
}

model KpiDefinitionVersion {
  version               String                          @id @db.VarChar(32)
  status                ReportingDefinitionStatus       @default(DRAFT)
  activeKey             String?                         @unique @db.VarChar(64)
  contractHash          String                          @db.Char(64)
  definition            Json
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  ticketFacts           TicketReportingFact[]
  processedEvents       ReportingProcessedEvent[]
  projectionCheckpoints ReportingProjectionCheckpoint[]
  supportJourneys       SupportJourney[]
  recurringSignals      RecurringProblemSignal[]

  @@index([status, effectiveFrom, effectiveTo])
}

model TicketReportingFact {
  id                                 BigInt                     @id @default(autoincrement())
  ticketId                           Int                        @unique
  definitionVersion                  String                     @db.VarChar(32)
  sourceAggregateVersion             Int                        @default(0)
  sourceLastEventId                  String?                    @db.Char(36)
  ticketCreatedAt                    DateTime
  slaStartedAt                       DateTime?
  firstResponseDueAt                 DateTime?
  resolutionDueAt                    DateTime?
  firstHumanPublicResponseAt         DateTime?
  firstResponsePauseMilliseconds     BigInt                     @default(0)
  firstResponseEffectiveMilliseconds BigInt?
  firstResolvedAt                    DateTime?
  resolutionPauseMilliseconds        BigInt                     @default(0)
  resolutionEffectiveMilliseconds    BigInt?
  firstClosedAt                      DateTime?
  lastClosedAt                       DateTime?
  fcrMaturesAt                       DateTime?
  fcrStatus                          ReportingFcrStatus         @default(EXCLUDED)
  firstResponseSlaState              SlaTargetState?
  resolutionSlaState                 SlaTargetState?
  reopenedWithinWindow               Boolean?
  reopenCount                        Int                        @default(0)
  resolutionRejectionCount           Int                        @default(0)
  reopenWithinWindowEventCount       Int                        @default(0)
  customerReopenWithinWindowCount    Int                        @default(0)
  staffReopenWithinWindowCount       Int                        @default(0)
  systemReopenWithinWindowCount      Int                        @default(0)
  publicStaffMessageCount            Int                        @default(0)
  publicCustomerMessageCount         Int                        @default(0)
  transferCount                      Int                        @default(0)
  collaborationCount                 Int                        @default(0)
  hasCustomerReplyAfterFirstResponse Boolean                    @default(false)
  rating                             Int?
  ratedAt                            DateTime?
  serviceId                          Int?
  serviceCode                        String?                    @db.VarChar(64)
  serviceName                        String?                    @db.VarChar(150)
  requestTypeId                      Int?
  requestTypeCode                    String?                    @db.VarChar(64)
  requestTypeName                    String?                    @db.VarChar(150)
  supportTeamId                      Int?
  supportTeamCode                    String?                    @db.VarChar(64)
  supportTeamName                    String?                    @db.VarChar(150)
  queueId                            Int?
  queueCode                          String?                    @db.VarChar(64)
  queueName                          String?                    @db.VarChar(150)
  ownerUserId                        Int?
  organizationId                     Int?
  partyType                          PartyType?
  partyKeyHash                       String?                    @db.Char(64)
  normalizedRootCauseId              Int?
  normalizedRootCauseCode            String?                    @db.VarChar(64)
  normalizedRootCauseName            String?                    @db.VarChar(150)
  incidentKey                        String?                    @db.VarChar(64)
  priorityAtCreation                 SupportPriority?
  priorityAtResolution               SupportPriority?
  channel                            String?                    @db.VarChar(32)
  slaPolicyCode                      String?                    @db.VarChar(64)
  slaPolicyVersion                   Int?
  legacyImported                     Boolean                    @default(false)
  dataQualityStatus                  ReportingDataQualityStatus @default(INCOMPLETE)
  exclusionReason                    String?                    @db.VarChar(100)
  createdAt                          DateTime                   @default(now())
  updatedAt                          DateTime                   @updatedAt
  ticket                             Ticket                     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  definition                         KpiDefinitionVersion       @relation(fields: [definitionVersion], references: [version], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketCreatedAt, dataQualityStatus])
  @@index([firstHumanPublicResponseAt])
  @@index([firstResolvedAt])
  @@index([firstClosedAt, reopenedWithinWindow])
  @@index([lastClosedAt, reopenedWithinWindow])
  @@index([fcrStatus, fcrMaturesAt])
  @@index([firstResponseSlaState, resolutionSlaState])
  @@index([firstResponseDueAt, firstResponseSlaState], map: "TicketReportingFact_first_response_due_state_idx")
  @@index([resolutionDueAt, resolutionSlaState], map: "TicketReportingFact_resolution_due_state_idx")
  @@index([serviceId, requestTypeId, ticketCreatedAt])
  @@index([supportTeamId, queueId, ticketCreatedAt])
  @@index([ownerUserId, ticketCreatedAt])
  @@index([organizationId, ticketCreatedAt])
  @@index([normalizedRootCauseId, ticketCreatedAt], map: "TicketReportingFact_root_cause_created_idx")
  @@index([incidentKey, ticketCreatedAt])
  @@index([partyKeyHash, ticketCreatedAt])
  @@index([rating, ratedAt])
}

model ReportingProcessedEvent {
  eventId           String                          @id @db.Char(36)
  outboxEventId     BigInt?                         @unique
  aggregateType     String                          @db.VarChar(64)
  aggregateId       String                          @db.VarChar(191)
  aggregateVersion  Int?
  eventType         String                          @db.VarChar(100)
  occurredAt        DateTime
  processedAt       DateTime                        @default(now())
  definitionVersion String                          @db.VarChar(32)
  outcome           ReportingEventProcessingOutcome
  reasonCode        String?                         @db.VarChar(100)
  definition        KpiDefinitionVersion            @relation(fields: [definitionVersion], references: [version], onDelete: Restrict, onUpdate: Cascade)

  @@index([eventType, occurredAt])
  @@index([aggregateType, aggregateId, aggregateVersion], map: "ReportingProcessedEvent_aggregate_version_idx")
  @@index([processedAt])
}

model ReportingProjectionCheckpoint {
  consumerName        String                    @id @db.VarChar(100)
  definitionVersion   String                    @db.VarChar(32)
  status              ReportingProjectionStatus @default(HEALTHY)
  lastOutboxEventId   BigInt?
  lastEventId         String?                   @db.Char(36)
  lastEventOccurredAt DateTime?
  lastProcessedAt     DateTime?
  rebuildStartedAt    DateTime?
  rebuildCompletedAt  DateTime?
  failureCount        Int                       @default(0)
  lastErrorCode       String?                   @db.VarChar(100)
  leaseToken          String?                   @unique @db.Char(36)
  leaseExpiresAt      DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  definition          KpiDefinitionVersion      @relation(fields: [definitionVersion], references: [version], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, lastProcessedAt])
  @@index([leaseExpiresAt])
}

model SupportJourney {
  id                            String                   @id @db.Char(36)
  definitionVersion             String                   @db.VarChar(32)
  partyKeyHash                  String                   @db.Char(64)
  organizationId                Int?
  serviceId                     Int?
  serviceCode                   String?                  @db.VarChar(64)
  requestTypeId                 Int?
  requestTypeCode               String?                  @db.VarChar(64)
  supportTeamId                 Int?
  channel                       String                   @db.VarChar(32)
  status                        SupportJourneyStatus     @default(STARTED)
  contentType                   String?                  @db.VarChar(32)
  contentReference              String?                  @db.VarChar(191)
  customerQuestion              String?                  @db.VarChar(500)
  contentIsPublicApprovedActive Boolean                  @default(false)
  knowledgeArticleVersionId     BigInt?
  startCommandKeyHash           String?                  @unique @db.Char(64)
  startPayloadHash              String?                  @db.Char(64)
  confirmationCommandKeyHash    String?                  @unique @db.Char(64)
  startedAt                     DateTime
  contentShownAt                DateTime?
  confirmedResolvedAt           DateTime?
  conversionDeadlineAt          DateTime?
  humanInterventionAt           DateTime?
  convertedTicketId             Int?
  outcomeFinalizedAt            DateTime?
  exclusionReason               String?                  @db.VarChar(100)
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  convertedTicket               Ticket?                  @relation("SupportJourneyConvertedTicket", fields: [convertedTicketId], references: [id], onDelete: SetNull)
  definition                    KpiDefinitionVersion     @relation(fields: [definitionVersion], references: [version], onDelete: Restrict, onUpdate: Cascade)
  knowledgeArticleVersion       KnowledgeArticleVersion? @relation(fields: [knowledgeArticleVersionId], references: [id], onDelete: Restrict)
  messages                      SupportJourneyMessage[]

  @@index([startedAt, status])
  @@index([status, conversionDeadlineAt])
  @@index([partyKeyHash, startedAt])
  @@index([organizationId, startedAt])
  @@index([serviceId, requestTypeId, startedAt])
  @@index([supportTeamId, startedAt])
  @@index([convertedTicketId])
  @@index([knowledgeArticleVersionId, startedAt])
}

model SupportJourneyMessage {
  id        BigInt                      @id @default(autoincrement())
  journeyId String                      @db.Char(36)
  author    SupportJourneyMessageAuthor
  kind      SupportJourneyMessageKind
  body      String                      @db.Text
  createdAt DateTime                    @default(now())
  journey   SupportJourney              @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, createdAt, id])
}

model SupportIncident {
  id                Int                     @id @default(autoincrement())
  incidentKey       String                  @unique @db.VarChar(64)
  title             String                  @db.VarChar(200)
  description       String                  @db.Text
  sourceType        SupportIncidentSource   @default(MANUAL)
  sourceReference   String?                 @db.VarChar(191)
  status            SupportIncidentStatus   @default(DETECTED)
  severity          SupportIncidentSeverity @default(MEDIUM)
  requestTypeId     Int?
  serviceCode       String?                 @db.VarChar(64)
